[Unit]
Description=BonBridge - network bridge for ESC/POS receipt printers
Documentation=https://github.com/loe17/bonbridge
After=network-online.target
Wants=network-online.target
# Avahi is optional; if it is present we want it up first so the mDNS
# announcement is picked up immediately.
After=avahi-daemon.service

[Service]
Type=simple
# Runs as root because it needs raw USB access (libusb / /dev/usb/lp0).
# Nothing is exposed except the two TCP ports; see the hardening below.
User=root
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/bonbridge/src
Environment=BONBRIDGE_ROOT=/opt/bonbridge
ExecStart=/usr/bin/python3 -m bonbridge run
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=mixed

# Light hardening - keeps device access, blocks the rest.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadWritePaths=/etc/bonbridge /var/lib/bonbridge /var/log/bonbridge /etc/avahi/services

[Install]
WantedBy=multi-user.target
